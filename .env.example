# Power BI Platform — environment template.
#
# Copy to .env and fill in. Both layers read from here: the API through
# pydantic-settings (api/app/config.py), and Alembic through the loader in
# api/alembic/env.py. The Next.js app reads application/.env.local — the two
# NEXT_* values below belong there as well.
#
# Every variable the API understands is declared in api/app/config.py. If it is
# not in that file, the API does not read it.

# ── Databases ────────────────────────────────────────────────────────────────
# Azure SQL / SQL Server. The driver name must match an ODBC driver installed on
# the host; the API container ships Driver 18.
#
#   Encrypt=yes is the default on Driver 18 and required by Azure SQL.
#   TrustServerCertificate=yes is for local servers only — never Azure.
#
# The default points at a SQL Server already running on localhost:1433 with the
# login below. `scripts/dev.sh` uses whatever server this URL names: if it can
# reach it, Docker is never started. Point the URL at localhost:15433 instead to
# use the throwaway container in docker-compose.yml.
APP_DATABASE_URL=mssql+aioodbc://biplatformadmin:biplatformadmin@localhost:1433/bi_platform_database?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# The warehouse connection is read-only and only ever reads the `marts` schema,
# so it can share the application database (as it does here) or name a separate
# one. Re-point it at the real warehouse when there is one.
WAREHOUSE_DATABASE_URL=mssql+aioodbc://biplatformadmin:biplatformadmin@localhost:1433/bi_platform_database?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Azure SQL Database, for reference:
# APP_DATABASE_URL=mssql+aioodbc://user:pass@myserver.database.windows.net:1433/biplatform_app?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
#
# PostgreSQL is supported end to end as well (see api/app/sql_compat.py):
# APP_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/biplatform_app

# ── Local dev database credentials ───────────────────────────────────────────
# Used both by a SQL Server you already run and by the throwaway container,
# which creates this login on first start so the two are interchangeable. Local
# development only — never these values anywhere reachable.
MSSQL_USER=biplatformadmin
MSSQL_PASSWORD=biplatformadmin
MSSQL_DATABASE=bi_platform_database

# The container's own sa password, used only to create the login above. Its host
# port is 15433 rather than 1433 because a machine with SQL Server installed
# already owns that one, and can hold several ports at once.
MSSQL_SA_PASSWORD=LocalDev_Passw0rd!
MSSQL_HOST_PORT=15433

# ── Auth ─────────────────────────────────────────────────────────────────────
# Shared between the API (JWT verification) and Auth.js (session signing), so
# the two MUST match. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Fernet key encrypting TOTP secrets and every stored client secret.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# ── Microsoft Entra ID (SSO) ─────────────────────────────────────────────────
# The only identity provider this build offers. Leave blank to keep password
# sign-in as the sole route; fill all three to add the "Sign in with Microsoft"
# button and register the Auth.js provider (application/src/lib/authProviders.ts).
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ── Frontend (application/.env.local) ────────────────────────────────────────
# NEXT_PUBLIC_API_URL is inlined into the browser bundle at build time, so a
# container image is bound to the environment it was built for.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Not required for a single-node deployment. It provides the pipeline poller's
# cross-worker lock and per-user notification rate limiting; both degrade
# gracefully when Redis is unreachable. Add it once you run more than one API
# replica, or duplicate alerts become possible.
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
# Export files, avatars, and brand assets. az:// is Azure Blob (adlfs ships by
# default); s3:// and gcs:// need their extras — see api/pyproject.toml.
STORAGE_URI=file:///data/storage
# STORAGE_URI=az://mycontainer
# AZURE_STORAGE_CONNECTION_STRING=

# ── Secrets backend ──────────────────────────────────────────────────────────
# env | azure | aws | gcp. Resolved once at startup (api/app/secrets.py).
SECRETS_BACKEND=env
AZURE_KEYVAULT_URL=

# ── Notifications ────────────────────────────────────────────────────────────
# Channels the dispatcher may use. Pipeline alert destinations are configured
# per notification group in the UI, not here.
NOTIFICATION_CHANNELS_ENABLED=email

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#data-alerts
TEAMS_WEBHOOK_URL=
GCHAT_WEBHOOK_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Export reports ───────────────────────────────────────────────────────────
# Ceilings on what one report may cost. The timeout is enforced by the database
# it queries, not by the API — cancelling on our side would leave the query
# running and still consuming the warehouse.
# EXPORT_QUERY_TIMEOUT_SECONDS=300
# Shorter, because a test exists to find a bad query cheaply.
# EXPORT_PREVIEW_TIMEOUT_SECONDS=30
# EXPORT_PREVIEW_ROWS=50
# EXPORT_MAX_ROWS=100000
# Rows x columns. This is what actually bounds memory: 1,000 rows of 300 columns
# costs the same as 100,000 rows of 3, and only one of them looks large.
# EXPORT_MAX_CELLS=2000000

# ── Feature flags ────────────────────────────────────────────────────────────
# Optional overrides. An env var always beats the database value, so setting one
# takes the toggle away from the API too — leave them unset unless you mean
# to pin a feature. Values: true/false/1/0.
# FEATURE_DASHBOARDS=true
# FEATURE_CUSTOM_PAGES=true
# FEATURE_EXPORTS=true
# FEATURE_GOVERNANCE=true
# FEATURE_PIPELINES=true
# FEATURE_EMBED_POWERBI=true
# FEATURE_EMBED_PAGE=true
# FEATURE_PIPELINES_ADF=true

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
# development | production. Controls log format (console vs JSON) and level.
ENV=development
